# RexSwap Indexer Environment Variables
# Copy this file to .env and fill in your values:
#   cp env.example .env

# ============================================
# ClickHouse Connection
# ============================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DB=rexswap

# ============================================
# RPC URLs (per network)
# ============================================
# Override RPC URLs per network
# Format: {NETWORK}_RPC_URL (uppercase, snake_case)
# Examples:
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
TESTNET_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ZILLIQA_TESTNET_RPC_URL=https://dev-api.zilliqa.com
LOCAL_RPC_URL=http://127.0.0.1:8545

# ============================================
# RexSwap Contract Addresses
# ============================================
# Main DEX contract (REQUIRED for RexSwap indexing!)
REXSWAP_DEX_ADDRESS=0x8630616b0198e7e449d0aad3603b73f665188025

# Optional: Proxy/Path contracts (if deployed separately)
# These are usually installed into the main DEX contract
HOT_PROXY_ADDRESS=
COLD_PATH_ADDRESS=
WARM_PATH_ADDRESS=
MICRO_PATHS_ADDRESS=
KNOCKOUT_PATH_ADDRESS=

# ============================================
# RexPump Contract Addresses
# ============================================
# PositionManager (hooks) - main contract with swap/pool events
REXPUMP_POSITION_MANAGER=0x789d72235bff6215b37ecf0f8deaa8f43a92f0dc

# BidWall contract
REXPUMP_BIDWALL=0x3d5052fc64dcec858fb178afec0011ee41f47f00

# FairLaunch contract
REXPUMP_FAIRLAUNCH=0x2a0849e2773164031d877614bb8bd8c7e6a6cd9f

# FeeEscrow contract
REXPUMP_FEE_ESCROW=0x58abe9779d3a3b399d9003b9d2675e65e76899fc

# RexPump NFT contract (pool ownership tokens)
REXPUMP_NFT=

# ============================================
# API Server
# ============================================
# Enable API server (true/false)
API_ENABLED=false

# API server host (0.0.0.0 = all interfaces)
API_HOST=0.0.0.0

# API server port (use something uncommon)
API_PORT=8882

# CORS allowed origins (comma-separated)
# Leave empty to allow all origins
API_CORS_ORIGINS=http://localhost:3000,https://your-app.com

# ============================================
# Logging
# ============================================
# Set log level: trace, debug, info, warn, error
RUST_LOG=info

